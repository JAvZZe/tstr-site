---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TSTR Hub - Specialist Testing Services, Products and Solutions Directory',
  description = 'Find and compare verified Testers and certification bodies worldwide. ISO 17025 accredited Testers for materials testing, environmental analysis, biotech, hydrogen infrastructure, and more.',
} = Astro.props;

// Fallback for AdSense ID if environment variable is missing in build pipeline
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-7003918988204966';
---

<!doctype html>
<html lang="en" class="bg-[#020203]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
      crossorigin="anonymous"></script>
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden font-sans antialiased selection:bg-blue-500/30 selection:text-white"
  >
    <!-- Ambient background glow -->
    <div class="pointer-events-none fixed inset-0 z-[-1] overflow-hidden">
      <div
        class="absolute -left-[10%] -top-[10%] h-[40%] w-[40%] rounded-full bg-blue-500/10 blur-[120px]"
      >
      </div>
      <div
        class="absolute -right-[10%] top-[20%] h-[35%] w-[35%] rounded-full bg-emerald-500/5 blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-[-10%] left-[20%] h-[30%] w-[30%] rounded-full bg-blue-600/5 blur-[120px]"
      >
      </div>
    </div>

    <Header showHero={false} />
    <main class="relative z-10">
      <slot />
    </main>
    <Footer />

    <!-- Consent banner (GDPR): gates all third-party tracking below -->
    <CookieConsent />

    <!-- Floating Search Button (Global) -->
    <div
      id="floating-search-container"
      class="pointer-events-none fixed bottom-8 right-8 z-[100] translate-y-10 opacity-0 transition-all duration-500"
    >
      <button
        id="floating-search-btn"
        class="group flex h-14 w-14 items-center justify-center rounded-full border border-white/10 bg-blue-600 text-white shadow-2xl shadow-blue-600/40 transition-all hover:scale-110 hover:bg-blue-500 active:scale-90 md:h-16 md:w-16"
        title="Search for Testers"
      >
        <span class="text-2xl transition-transform group-hover:rotate-12 md:text-3xl">🔍</span>
        <div class="pointer-events-none absolute inset-0 animate-ping rounded-full bg-blue-400/20">
        </div>
      </button>
    </div>

    <style is:global>
      @keyframes bounce-subtle {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
      }
      .animate-bounce-subtle {
        animation: bounce-subtle 3s infinite ease-in-out;
      }
    </style>

    <script>
      import { hasAnalyticsConsent } from '../lib/analytics';
      function initFloatingSearch() {
        const container = document.getElementById('floating-search-container');
        const btn = document.getElementById('floating-search-btn');
        if (!container || !btn) return;

        let lastScroll = 0;
        let ticking = false;

        window.addEventListener('scroll', () => {
          lastScroll = window.scrollY || document.documentElement.scrollTop;
          if (!ticking) {
            window.requestAnimationFrame(() => {
              if (lastScroll > 400) {
                container.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
                container.classList.add('animate-bounce-subtle');
              } else {
                container.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
                container.classList.remove('animate-bounce-subtle');
              }
              ticking = false;
            });
            ticking = true;
          }
        });

        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });

          // Try to focus the search input if it exists (on index page)
          setTimeout(() => {
            const input = document.getElementById('ai-search-input');
            if (input) {
              input.focus();
            } else {
              // If no search input on this page, maybe redirect to browse?
              // For now, just scroll to top is fine for a "back to search" experience
            }
          }, 600);
        });
      }

      // Initialize on load and on view transition
      initFloatingSearch();
      document.addEventListener('astro:after-swap', initFloatingSearch);

      function initApollo() {
        if (!hasAnalyticsConsent()) return; // consent-gated (GDPR)
        if (navigator.doNotTrack === '1') return; // respect DNT
        var n = Math.random().toString(36).substring(7),
          o = document.createElement('script');
        ((o.src = 'https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache=' + n),
          (o.async = !0),
          (o.defer = !0),
          (o.onload = function () {
            window.trackingFunctions.onLoad({ appId: '6979e8021ac917001927e9b2' });
          }),
          document.head.appendChild(o));
      }

      // Load Apollo only after consent; re-check on every Astro view transition.
      function maybeApollo() {
        initApollo();
        document.addEventListener('astro:after-swap', initApollo);
      }
      maybeApollo();

      // Load configured privacy-respecting traffic analytics after consent.
      import('../lib/analytics').then((m) => m.enableAnalyticsOnConsent()).catch(() => {});
    </script>
  </body>
</html>
