---
import NewsletterBanner from './NewsletterBanner';
const { showHero = true } = Astro.props;
---

<NewsletterBanner client:load />
<header class="glass-panel sticky top-0 z-50 px-6 py-4 transition-all duration-300 md:px-12">
  <div class="mx-auto flex max-w-7xl items-center justify-between">
    <!-- Logo Section -->
    <div class="logo">
      <a href="/" class="group flex items-center text-white no-underline">
        <img
          src="/TSTR-Logo-60px.png"
          alt="TSTR Logo"
          class="mr-4 h-12 w-auto transition-transform duration-300 group-hover:scale-110"
        />
        <div class="flex flex-col">
          <span class="text-xl font-black leading-none tracking-widest md:text-2xl">TSTR</span>
          <span
            class="text-2xl font-light leading-none tracking-tighter text-emerald-400 md:text-3xl"
            >hub</span
          >
        </div>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav id="desktop-nav" class="desktop-nav hidden items-center gap-4 md:flex">
      <!-- Navigation will be populated by JavaScript -->
    </nav>

    <!-- Mobile Hamburger Menu -->
    <button
      id="hamburger-btn"
      class="hamburger-btn cursor-pointer border-none bg-transparent p-2 text-2xl text-white md:hidden"
    >
      ☰
    </button>
  </div>

  {
    showHero && (
      <div class="animate-fade-up mx-auto mb-8 mt-12 max-w-4xl text-center">
        <h1 class="mb-4 text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl">
          Specialist Testing{' '}
          <span class="bg-gradient-to-r from-blue-400 to-emerald-400 bg-clip-text text-transparent">
            Services & Solutions
          </span>
        </h1>
        <p class="text-lg font-medium text-slate-400 md:text-xl">
          Oil & Gas • Biopharma • Environmental • Materials Testing
        </p>
      </div>
    )
  }

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-0 z-[60] hidden bg-[#020203]/95 p-8 backdrop-blur-xl"
  >
    <div class="flex h-full flex-col">
      <div class="mb-12 flex items-center justify-between">
        <span class="text-2xl font-bold tracking-widest"
          >TSTR <span class="text-emerald-400">hub</span></span
        >
        <button
          id="close-menu-btn"
          class="cursor-pointer border-none bg-transparent text-4xl text-white">×</button
        >
      </div>
      <nav id="mobile-nav" class="flex flex-col gap-6">
        <!-- Mobile navigation will be populated by JavaScript -->
      </nav>
    </div>
  </div>
</header>

<script>
  import { supabaseBrowser } from '../lib/supabase-browser';

  function createNavLink(href, text, isPrimary = false) {
    const link = document.createElement('a');
    link.href = href;
    link.textContent = text;

    if (isPrimary) {
      link.className =
        'px-6 py-2.5 rounded-full font-bold text-white transition-all duration-300 text-center block md:inline-block bg-gradient-to-r from-blue-600 to-emerald-500 hover:scale-105 hover:shadow-[0_0_20px_rgba(16,185,129,0.3)] shadow-lg';
    } else {
      link.className =
        'px-4 py-2 rounded-lg font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all duration-200 text-center block md:inline-block';
    }

    return link;
  }

  async function updateNavigation() {
    try {
      const {
        data: { session },
      } = await supabaseBrowser.auth.getSession();
      const isLoggedIn = !!session?.user;

      // Navigation Items
      const navItems = [
        { href: '/browse', text: 'Search', primary: false },
        { href: '/blog', text: 'Blog', primary: false },
        { href: '/pricing', text: 'Pricing', primary: false },
        { href: '/contact', text: 'Contact', primary: false },
      ];

      // Update desktop nav
      const desktopNav = document.getElementById('desktop-nav');
      if (desktopNav) {
        desktopNav.innerHTML = '';

        // Auth Link
        const authLink = isLoggedIn
          ? createNavLink('/account', 'My Account', true)
          : createNavLink('/login', 'Login', true);

        // Add auth link first on desktop
        desktopNav.appendChild(authLink);

        // Add other nav items
        navItems.forEach((item) => {
          desktopNav.appendChild(createNavLink(item.href, item.text, item.primary));
        });
      }

      // Update mobile nav
      const mobileNav = document.getElementById('mobile-nav');
      if (mobileNav) {
        mobileNav.innerHTML = '';

        const authLink = isLoggedIn
          ? createNavLink('/account', 'My Account', true)
          : createNavLink('/login', 'Login / Register', true);

        mobileNav.appendChild(authLink);

        navItems.forEach((item) => {
          mobileNav.appendChild(createNavLink(item.href, item.text, item.primary));
        });
      }
    } catch (error) {
      console.error('Error updating navigation:', error);
    }
  }

  // Mobile menu toggle
  function initMobileMenu() {
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('close-menu-btn');

    if (hamburgerBtn && mobileMenu) {
      hamburgerBtn.addEventListener('click', () => {
        mobileMenu.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = '';
        });
      }

      // Close menu when clicking outside
      mobileMenu.addEventListener('click', (e) => {
        if (e.target === mobileMenu) {
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });
    }
  }

  // Initialize
  updateNavigation();
  initMobileMenu();

  // Listen for auth changes
  supabaseBrowser.auth.onAuthStateChange((event, session) => {
    updateNavigation();
  });
</script>
