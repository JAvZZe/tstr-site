---
interface Props {
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'vertical' | 'horizontal';
  responsive?: boolean;
  className?: string;
  style?: string;
}

const {
  slot, // Should be a 10-digit numeric ID from AdSense dashboard
  format = 'auto',
  responsive = true,
  className = '',
  style = 'display:block',
} = Astro.props;

// Fallback for AdSense ID if environment variable is missing in build pipeline
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-7003918988204966';

// Validation: AdSense slots MUST be numeric strings
const isValidSlot = slot && /^\d+$/.test(slot);
---

<div
  class={`ad-container my-8 overflow-hidden rounded-xl bg-white/5 border border-white/10 p-4 transition-all hover:border-white/20 ${className}`}
>
  <div class="mb-2 text-center text-[10px] uppercase tracking-wider text-white/30">
    Advertisement
  </div>
  {
    isValidSlot ? (
      <>
        <ins
          class="adsbygoogle"
          style={style}
          data-ad-client={adsenseId}
          data-ad-slot={slot}
          data-ad-format={format}
          data-full-width-responsive={responsive ? 'true' : 'false'}
        />
        <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </>
    ) : (
      <div class="rounded-lg border-2 border-dashed border-white/5 py-12 text-center">
        <p class="text-xs font-medium text-slate-500">Ad Unit Placeholder</p>
        <p class="mt-1 text-[9px] uppercase tracking-widest text-slate-600">Pending Slot ID</p>
      </div>
    )
  }
</div>

<style>
  .ad-container {
    min-height: 100px;
  }
</style>
