---
// AccreditationBadges.astro
// Renders a lab's accreditations (from the `certifications` table) as trust badges.
// Each badge can show TWO links (user's choice per cert):
//   - `certificate_url`      : the certificate on the lab's OWN site (original-source link)
//   - `local_certificate_url`: OUR hosted copy on TSTR (asset we control, SEO-friendly)
// If only one is present, that one renders. If both, both render with distinct labels.
//
// Reusable: any listing with `certifications` rows gets the same treatment.
interface Cert {
  id?: string;
  issuing_body?: string | null;
  name?: string | null;
  expiry_date?: string | null;
  certificate_url?: string | null; // lab's own-site certificate (original source)
  local_certificate_url?: string | null; // TSTR-hosted copy (our asset)
}
interface Props {
  certifications?: Cert[] | null;
  website?: string | null;
  accent?: string;
  /** Listing UUID — the claim page reads this as `?id=`. */
  listingId?: string | null;
  /** Lab name, shown in the "is this your lab?" prompt. */
  businessName?: string | null;
  /** Set false to hide the empty-state entirely (e.g. compact views). */
  showEmptyState?: boolean;
}
const {
  certifications,
  website,
  accent = 'emerald',
  listingId = null,
  businessName = null,
  showEmptyState = true,
} = Astro.props;

const hasCerts = Array.isArray(certifications) && certifications.length > 0;

// Slots we invite the lab to complete. These are LABELLED PLACEHOLDERS —
// deliberately NOT fake certificate data. Showing invented accreditations would
// mislead buyers and breaks the project rule "never invent certifications".
const requestedSlots = [
  { label: 'ISO/IEC 17025', hint: 'Testing & calibration competence' },
  { label: 'Accreditation body', hint: 'e.g. UKAS, A2LA, SAC, DAkkS' },
  { label: 'Certificate number', hint: 'For independent verification' },
  { label: 'Scope of accreditation', hint: 'PDF or scope document' },
];

// Deep-link the claim flow with params the claim page ACTUALLY reads: it parses
// `provider` (display name) and `id`/`listingId`. A `?listing=` param would be
// silently ignored, losing the lab context.
const claimParams = new URLSearchParams();
if (businessName) claimParams.set('provider', businessName);
if (listingId) claimParams.set('id', listingId);
const claimHref = claimParams.toString() ? `/claim?${claimParams.toString()}` : '/claim';

const fmtDate = (d?: string | null) => {
  if (!d) return null;
  try {
    return new Date(d).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  } catch {
    return d;
  }
};

// Fallback when neither cert URL is set: lab's own accreditations page.
const siteFallback = (c: Cert) => {
  if (website) return `${website.replace(/\/+$/, '')}/accreditations`;
  return null;
};
---

{
  hasCerts && (
    <div class="glass-panel border-emerald-500/20 bg-emerald-500/5 p-6">
      <h3 class="mb-1 flex items-center gap-2 text-lg font-bold text-white">
        <span class="h-5 w-1.5 rounded-full bg-emerald-500" />
        Accreditations & Certifications
      </h3>
      <p class="mb-4 text-xs text-gray-400">
        Independently issued scopes of accreditation. View the certificate on the lab's site or on
        TSTR.
      </p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {certifications.map((c) => {
          const exp = fmtDate(c.expiry_date);
          const label = c.issuing_body || 'Accredited';
          const local = c.local_certificate_url || null;
          const orig = c.certificate_url || siteFallback(c);
          return (
            <div class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3 transition-colors hover:bg-white/10">
              <div class="min-w-0">
                <div class="truncate text-sm font-semibold text-white">{label}</div>
                <div class="truncate text-xs text-gray-400">{c.name || 'Accreditation'}</div>
                {exp && <div class="mt-0.5 text-[11px] text-emerald-400/80">Valid to {exp}</div>}
              </div>
              <div class="ml-3 flex shrink-0 flex-col items-end gap-1">
                {local && (
                  <a
                    href={local}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`shrink-0 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors bg-${accent}-600/25 hover:bg-${accent}-600/40 text-${accent}-200 border-${accent}-500/30 hover:text-white`}
                  >
                    TSTR copy ↗
                  </a>
                )}
                {orig && (
                  <a
                    href={orig}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`shrink-0 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors ${
                      local
                        ? 'border-white/10 bg-white/5 text-gray-300 hover:bg-white/10 hover:text-white'
                        : `bg-${accent}-600/25 hover:bg-${accent}-600/40 text-${accent}-200 border-${accent}-500/30 hover:text-white`
                    }`}
                  >
                    {local ? 'Lab site ↗' : 'View ↗'}
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )
}

{
  !hasCerts && showEmptyState && (
    <div class="glass-panel border-amber-500/20 bg-amber-500/5 p-6">
      <h3 class="mb-1 flex items-center gap-2 text-lg font-bold text-white">
        <span class="h-5 w-1.5 rounded-full bg-amber-500" />
        Accreditations & Certifications
      </h3>
      <p class="mb-4 text-xs text-amber-200/80">
        <span class="font-semibold">Not yet supplied.</span> We haven't received accreditation
        documents for this lab, so we show nothing rather than guess. Ask the lab for current
        certificates before you place an order.
      </p>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {requestedSlots.map((s) => (
          <div class="flex items-center justify-between rounded-xl border border-dashed border-white/15 bg-white/[0.03] p-3">
            <div class="min-w-0">
              <div class="truncate text-sm font-semibold text-gray-300">{s.label}</div>
              <div class="truncate text-xs text-gray-500">{s.hint}</div>
            </div>
            <span class="ml-3 shrink-0 rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-medium text-gray-400">
              Awaiting
            </span>
          </div>
        ))}
      </div>

      <div class="mt-5 flex flex-col gap-3 border-t border-white/10 pt-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-gray-400">
          {businessName ? `Do you work at ${businessName}?` : 'Is this your laboratory?'} Claim the
          profile to add your accreditations. It's free.
        </p>
        <a
          href={claimHref}
          class="shrink-0 rounded-lg border border-amber-500/30 bg-amber-600/25 px-4 py-2 text-xs font-semibold text-amber-100 transition-colors hover:bg-amber-600/40 hover:text-white"
        >
          Claim this profile →
        </a>
      </div>
    </div>
  )
}
