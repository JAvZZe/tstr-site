---
// AccreditationBadges.astro
// Renders a lab's accreditations (from the `certifications` table) as trust badges.
// Each badge can show TWO links (user's choice per cert):
//   - `certificate_url`      : the certificate on the lab's OWN site (original-source link)
//   - `local_certificate_url`: OUR hosted copy on TSTR (asset we control, SEO-friendly)
// If only one is present, that one renders. If both, both render with distinct labels.
//
// Reusable: any listing with `certifications` rows gets the same treatment.
interface Cert {
  id?: string;
  issuing_body?: string | null;
  name?: string | null;
  expiry_date?: string | null;
  certificate_url?: string | null; // lab's own-site certificate (original source)
  local_certificate_url?: string | null; // TSTR-hosted copy (our asset)
}
interface Props {
  certifications?: Cert[] | null;
  website?: string | null;
  accent?: string;
}
const { certifications, website, accent = 'emerald' } = Astro.props;

const fmtDate = (d?: string | null) => {
  if (!d) return null;
  try {
    return new Date(d).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  } catch {
    return d;
  }
};

// Fallback when neither cert URL is set: lab's own accreditations page.
const siteFallback = (c: Cert) => {
  if (website) return `${website.replace(/\/+$/, '')}/accreditations`;
  return null;
};
---

{
  certifications && certifications.length > 0 && (
    <div class="glass-panel border-emerald-500/20 bg-emerald-500/5 p-6">
      <h3 class="mb-1 flex items-center gap-2 text-lg font-bold text-white">
        <span class="h-5 w-1.5 rounded-full bg-emerald-500" />
        Accreditations & Certifications
      </h3>
      <p class="mb-4 text-xs text-gray-400">
        Independently issued scopes of accreditation. View the certificate on the lab's site or on
        TSTR.
      </p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {certifications.map((c) => {
          const exp = fmtDate(c.expiry_date);
          const label = c.issuing_body || 'Accredited';
          const local = c.local_certificate_url || null;
          const orig = c.certificate_url || siteFallback(c);
          return (
            <div class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3 transition-colors hover:bg-white/10">
              <div class="min-w-0">
                <div class="truncate text-sm font-semibold text-white">{label}</div>
                <div class="truncate text-xs text-gray-400">{c.name || 'Accreditation'}</div>
                {exp && <div class="mt-0.5 text-[11px] text-emerald-400/80">Valid to {exp}</div>}
              </div>
              <div class="ml-3 flex shrink-0 flex-col items-end gap-1">
                {local && (
                  <a
                    href={local}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`shrink-0 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors bg-${accent}-600/25 hover:bg-${accent}-600/40 text-${accent}-200 border-${accent}-500/30 hover:text-white`}
                  >
                    TSTR copy ↗
                  </a>
                )}
                {orig && (
                  <a
                    href={orig}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`shrink-0 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors ${
                      local
                        ? 'border-white/10 bg-white/5 text-gray-300 hover:bg-white/10 hover:text-white'
                        : `bg-${accent}-600/25 hover:bg-${accent}-600/40 text-${accent}-200 border-${accent}-500/30 hover:text-white`
                    }`}
                  >
                    {local ? 'Lab site ↗' : 'View ↗'}
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )
}
