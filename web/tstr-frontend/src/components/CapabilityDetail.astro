---
// CapabilityDetail.astro
// Renders ONE standard/certification capability with rich detail pulled from the
// `listing_capabilities.specifications` JSON. Falls back to a simple code+name card
// when `specifications` is empty (so every listing still renders, but only labs that
// populate specs get the premium treatment).
//
// This is the reusable TEMPLATE that makes a listing "sellable": any lab that fills
// in its `specifications` JSON automatically gets method chips, scope notes, and a
// working "find other labs" link.
interface Specs {
  test_methods?: string[];
  scope_note?: string;
  related_standards?: string[];
  max_pressure_bar?: number;
  temperature_range_c?: string;
  sample_geometry?: string;
  accreditation?: string;
  turnaround_days?: number;
  claim_source?: string;
  [k: string]: unknown;
}
interface Props {
  code: string;
  name: string;
  specs?: Specs | null;
  notes?: string | null;
  verified?: boolean | null;
  standardSlug?: string | null;
}
const { code, name, specs, notes, verified, standardSlug } = Astro.props;
const hasSpecs = specs && Object.keys(specs).length > 0;
---

{
  hasSpecs ? (
    <div class="rounded-xl border border-emerald-500/20 bg-white/5 p-4 transition-colors hover:bg-white/10">
      <div class="flex items-start justify-between gap-3">
        <div>
          <span class="mb-1 block text-xs font-bold uppercase tracking-widest text-emerald-400">
            {code}
          </span>
          <span class="font-medium text-gray-200">{name}</span>
        </div>
        {verified ? (
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-emerald-500/30 bg-emerald-500/15 px-2 py-0.5 text-[10px] font-bold uppercase text-emerald-300">
            Verified
          </span>
        ) : (
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 text-[10px] font-bold uppercase text-amber-300">
            Self-declared
          </span>
        )}
      </div>

      {specs.test_methods && Array.isArray(specs.test_methods) && specs.test_methods.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {specs.test_methods.map((m: string) => (
            <span class="rounded border border-blue-500/20 bg-blue-500/10 px-2 py-0.5 text-[11px] text-blue-300">
              {m}
            </span>
          ))}
        </div>
      )}

      {specs.scope_note && (
        <p class="mt-3 text-sm leading-relaxed text-gray-300">{specs.scope_note}</p>
      )}

      {(specs.max_pressure_bar ||
        specs.temperature_range_c ||
        specs.sample_geometry ||
        specs.turnaround_days) && (
        <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
          {specs.max_pressure_bar && (
            <div class="rounded bg-black/20 p-2">
              <span class="block text-gray-500">Max pressure</span>
              <span class="text-gray-200">{specs.max_pressure_bar} bar</span>
            </div>
          )}
          {specs.temperature_range_c && (
            <div class="rounded bg-black/20 p-2">
              <span class="block text-gray-500">Temp range</span>
              <span class="text-gray-200">{specs.temperature_range_c} °C</span>
            </div>
          )}
          {specs.sample_geometry && (
            <div class="rounded bg-black/20 p-2">
              <span class="block text-gray-500">Sample</span>
              <span class="text-gray-200">{specs.sample_geometry}</span>
            </div>
          )}
          {specs.turnaround_days && (
            <div class="rounded bg-black/20 p-2">
              <span class="block text-gray-500">Turnaround</span>
              <span class="text-gray-200">~{specs.turnaround_days} days</span>
            </div>
          )}
        </div>
      )}

      {specs.related_standards &&
        Array.isArray(specs.related_standards) &&
        specs.related_standards.length > 0 && (
          <div class="mt-3 text-xs text-gray-400">
            <span class="text-gray-500">Related: </span>
            {specs.related_standards.join(', ')}
          </div>
        )}

      {standardSlug && (
        <a
          href={`/testing/standards/${standardSlug}`}
          class="mt-3 inline-block text-xs text-emerald-300 underline-offset-2 hover:text-white hover:underline"
        >
          See other labs with this standard →
        </a>
      )}
    </div>
  ) : (
    <div class="group flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-4 transition-colors hover:bg-white/10">
      <div>
        <span class="mb-1 block text-xs font-bold uppercase tracking-widest text-gray-500">
          {code}
        </span>
        <span class="text-gray-200 transition-colors group-hover:text-blue-400">{name}</span>
      </div>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600/20">
        <svg class="h-4 w-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      </div>
    </div>
  )
}
