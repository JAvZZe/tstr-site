---
/**
 * Minimal cookie/consent banner.
 * - Stores choice in localStorage ("tstr-consent": "all" | "necessary").
 * - On "Accept all", enables third-party analytics (Apollo + PUBLIC_ANALYTICS_ID).
 * - Shown only until a choice is made. GDPR-friendly: no tracking before consent.
 */
---

<div id="cookie-consent" class="fixed inset-x-0 bottom-0 z-[200] hidden">
  <div
    class="m-4 mx-auto flex max-w-3xl flex-col gap-4 rounded-xl border border-white/10 bg-[#0b0d12] p-4 shadow-2xl sm:flex-row sm:items-center"
  >
    <p class="flex-1 text-sm text-gray-300">
      We use cookies for essential site function and, with your consent, for anonymous traffic
      analytics (to understand which labs and standards visitors search for). See our <a
        href="/privacy"
        class="text-blue-400 underline">Privacy Policy</a
      >.
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        id="cc-necessary"
        class="rounded-lg border border-white/15 px-3 py-2 text-sm text-gray-300 hover:bg-white/5"
      >
        Necessary only
      </button>
      <button
        id="cc-accept"
        class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-500"
      >
        Accept all
      </button>
    </div>
  </div>
</div>

<script>
  import { enableAnalyticsOnConsent } from '../lib/analytics';

  const KEY = 'tstr-consent';
  const banner = document.getElementById('cookie-consent');

  function close() {
    banner?.classList.add('hidden');
  }

  function decide(choice: 'all' | 'necessary') {
    try {
      localStorage.setItem(KEY, choice);
    } catch {
      /* ignore */
    }
    close();
    if (choice === 'all') enableAnalyticsOnConsent();
  }

  let stored: string | null = null;
  try {
    stored = localStorage.getItem(KEY);
  } catch {
    /* ignore */
  }

  if (!stored && banner) {
    banner.classList.remove('hidden');
  }

  document.getElementById('cc-accept')?.addEventListener('click', () => decide('all'));
  document.getElementById('cc-necessary')?.addEventListener('click', () => decide('necessary'));
</script>
