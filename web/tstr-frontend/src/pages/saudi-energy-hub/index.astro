---
export const prerender = true;
import { supabase } from '../../lib/supabase';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import StandardMatrix from '../../components/StandardMatrix';
import ContactLabModal from '../../components/ContactLabModal';

// Saudi Energy Category IDs
const CATEGORY_IDS = [
  'ac84835d-8f7b-48ed-b67f-21fa1a574768', // Renewable Energy Testing & Certification
  '811e6df8-bdf9-4838-981c-c4716a82d6e0', // Energy Technology
];

// Fetch all standards for these categories
const { data: energyStandards, error: standardsError } = await supabase
  .from('standards')
  .select('id, code, name, description, category_id')
  .in('category_id', CATEGORY_IDS)
  .eq('is_active', true)
  .order('code');

// Primary Labs for the Hub (Saudi Tier-1)
const PRIMARY_LAB_IDS = [
  'a0b5ee02-6968-4e7b-8a4e-040e48ea9f61', // GCC Lab
  'e1e25686-165b-4f1e-9071-9d926a8bb299', // Al-Hoty Stanger
  '6a3e6873-459d-4be5-8897-e678ff273e29', // ETLCO
];

// Fetch lab data and capabilities for the matrix
const { data: labsData, error: labsError } = await supabase
  .from('listings')
  .select(
    `
    id, 
    business_name,
    listing_capabilities(standard_id)
  `
  )
  .in('id', PRIMARY_LAB_IDS);

const matrixLabs =
  labsData?.map((lab) => ({
    id: lab.id,
    business_name: lab.business_name,
    capabilities: lab.listing_capabilities.map((c) => c.standard_id),
  })) || [];

// Stats
const energyStandardIds = energyStandards?.map((s) => s.id) || [];
let uniqueLabCount = 0;
if (energyStandardIds.length > 0) {
  const { data: totalLabs, error: totalError } = await supabase
    .from('listing_capabilities')
    .select('listing_id')
    .in('standard_id', energyStandardIds);
  uniqueLabCount = new Set(totalLabs?.map((l) => l.listing_id) || []).size;
}

const title = 'Saudi Energy Testing Hub | SASO & Aramco Certified Laboratory Network';
const description =
  'Discover and compare Tier-1 Saudi laboratories for renewable energy, power systems, and oil & gas infrastructure. Access ISO 17025 accredited facilities compliant with SASO and Aramco requirements.';
---

<BaseLayout title={title} description={description}>
  <div class="bg-primary text-text-primary selection:bg-tertiary/30 min-h-screen overflow-x-hidden">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-6 pb-20 pt-24">
      <div class="absolute inset-0 z-0">
        <div
          class="bg-tertiary/5 absolute left-[-10%] top-[-10%] h-[50%] w-[50%] rounded-full blur-[120px]"
        >
        </div>
        <div
          class="bg-accent/5 absolute bottom-[-10%] right-[-10%] h-[40%] w-[40%] rounded-full blur-[120px]"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl text-center">
        <div
          class="border-tertiary/30 bg-tertiary/10 text-tertiary animate-fade-up mb-8 inline-flex items-center rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-widest"
        >
          <span class="relative mr-3 flex h-2 w-2">
            <span
              class="bg-tertiary/40 absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
            ></span>
            <span class="bg-tertiary relative inline-flex h-2 w-2 rounded-full"></span>
          </span>
          Kingdom of Saudi Arabia Energy Gateway
        </div>

        <h1
          class="animate-fade-up mb-8 text-5xl font-black leading-none tracking-tighter delay-100 md:text-7xl"
        >
          The <span
            class="from-tertiary bg-gradient-to-r to-yellow-600 bg-clip-text text-transparent"
            >Saudi Energy</span
          > Hub
        </h1>

        <p
          class="text-text-secondary animate-fade-up mx-auto mb-12 max-w-2xl text-lg font-medium delay-200 md:text-xl"
        >
          Strategic access to mission-critical infrastructure testing. Accelerating Vision 2030
          through verified laboratory excellence in Renewables, Power, and Material Integrity.
        </p>

        <div
          class="animate-fade-up flex flex-col items-center justify-center gap-4 delay-300 sm:flex-row"
        >
          <a
            href="#matrix"
            class="bg-tertiary text-primary shadow-tertiary/20 rounded-xl px-8 py-4 font-bold shadow-xl transition-all hover:bg-yellow-600 active:scale-95"
          >
            Compare KSA Laboratories
          </a>
          <a
            href="#rfq"
            class="rounded-xl border border-white/10 bg-white/5 px-8 py-4 font-bold text-white transition-all hover:bg-white/10 active:scale-95"
          >
            Request Technical Proposal
          </a>
        </div>

        <div
          class="animate-fade-up delay-400 mt-20 grid grid-cols-2 gap-8 border-t border-white/5 pt-10 md:grid-cols-4"
        >
          <div>
            <div class="text-3xl font-black text-white">{uniqueLabCount}</div>
            <div class="text-text-secondary mt-1 text-[10px] uppercase tracking-widest">
              Verified Labs
            </div>
          </div>
          <div>
            <div class="text-3xl font-black text-white">{energyStandards?.length || 0}</div>
            <div class="text-text-secondary mt-1 text-[10px] uppercase tracking-widest">
              Active Standards
            </div>
          </div>
          <div>
            <div class="text-3xl font-black text-white">VISION</div>
            <div class="text-text-secondary mt-1 text-[10px] uppercase tracking-widest">
              2030 Aligned
            </div>
          </div>
          <div>
            <div class="text-3xl font-black text-white">SASO</div>
            <div class="text-text-secondary mt-1 text-[10px] uppercase tracking-widest">
              Compliant Network
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Matrix -->
    <section id="matrix" class="bg-secondary/30 relative px-6 py-24">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16">
          <h2 class="mb-4 flex items-center gap-3 text-3xl font-black">
            <span class="bg-tertiary h-8 w-1.5 rounded-full"></span>
            Technical Verification Matrix
          </h2>
          <p class="text-text-secondary max-w-xl font-medium">
            Comparative benchmarking of Tier-1 Saudi facilities against international and regional
            energy standards.
          </p>
        </div>

        <div class="animate-fade-up delay-500">
          <StandardMatrix
            client:load
            standards={energyStandards?.slice(0, 15) || []}
            labs={matrixLabs}
          />
        </div>

        <p class="text-text-secondary mt-8 text-xs italic">
          * Laboratory capabilities are verified against current ISO 17025 accreditation scopes.
        </p>
      </div>
    </section>

    <!-- Value Pillars -->
    <section class="px-6 py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <!-- Renewables -->
          <div
            class="bg-secondary/50 hover:border-tertiary/30 group rounded-3xl border border-white/5 p-8 backdrop-blur-sm transition-all"
          >
            <div
              class="bg-tertiary/10 border-tertiary/20 mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border"
            >
              <svg
                class="text-tertiary h-6 w-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
              </svg>
            </div>
            <h3 class="mb-4 text-xl font-bold">Renewable Infrastructure</h3>
            <p class="text-text-secondary mb-6 text-sm leading-relaxed">
              PV module type approval (IEC 61215) and wind turbine design validation for the Saudi
              National Renewable Energy Program (NREP).
            </p>
            <a
              href="/search/standards?category=Renewable"
              class="text-tertiary flex items-center text-sm font-bold transition-all group-hover:gap-2"
            >
              Explore Standards <span class="ml-1">→</span>
            </a>
          </div>

          <!-- Power Systems -->
          <div
            class="bg-secondary/50 hover:border-tertiary/30 group rounded-3xl border border-white/5 p-8 backdrop-blur-sm transition-all"
          >
            <div
              class="bg-tertiary/10 border-tertiary/20 mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border"
            >
              <svg
                class="text-tertiary h-6 w-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="mb-4 text-xl font-bold">Grid & Power Technology</h3>
            <p class="text-text-secondary mb-6 text-sm leading-relaxed">
              High-voltage testing and smart grid certification. Supporting the modernization of the
              Saudi electricity network.
            </p>
            <a
              href="/search/standards?category=Power"
              class="text-tertiary flex items-center text-sm font-bold transition-all group-hover:gap-2"
            >
              Verify Grid Labs <span class="ml-1">→</span>
            </a>
          </div>

          <!-- Material Integrity -->
          <div
            class="bg-secondary/50 hover:border-tertiary/30 group rounded-3xl border border-white/5 p-8 backdrop-blur-sm transition-all"
          >
            <div
              class="bg-tertiary/10 border-tertiary/20 mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border"
            >
              <svg
                class="text-tertiary h-6 w-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <h3 class="mb-4 text-xl font-bold">Industrial Compliance</h3>
            <p class="text-text-secondary mb-6 text-sm leading-relaxed">
              Non-destructive testing (NDT) and metallurgical analysis for Aramco projects and
              petrochemical infrastructure.
            </p>
            <a
              href="/search/standards?category=Testing"
              class="text-tertiary flex items-center text-sm font-bold transition-all group-hover:gap-2"
            >
              View Capabilities <span class="ml-1">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision 2030 Content Section -->
    <section class="mx-auto max-w-4xl px-6 py-24">
      <div class="prose prose-invert max-w-none">
        <h2 class="mb-8 text-3xl font-black text-white">
          Unified Testing for a Transforming Kingdom
        </h2>
        <p class="text-text-secondary mb-6 font-medium leading-relaxed">
          Saudi Arabia is diversifying its energy mix, and that work needs testing capacity close to
          the projects themselves. This hub lists laboratories that serve those projects, so you can
          match a requirement to a provider in the region rather than shipping samples abroad.
        </p>
        <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-2">
          <div>
            <h4 class="text-tertiary mb-4 text-xs font-bold uppercase tracking-widest">
              Standardization
            </h4>
            <p class="text-text-secondary text-sm leading-relaxed">
              Direct mapping of SASO standards to international IEC and ISO equivalents, ensuring
              global export compatibility for Saudi-made energy components.
            </p>
          </div>
          <div>
            <h4 class="text-tertiary mb-4 text-xs font-bold uppercase tracking-widest">
              Local Content
            </h4>
            <p class="text-text-secondary text-sm leading-relaxed">
              Prioritizing IKTVA-aligned laboratory facilities to strengthen the domestic technical
              ecosystem and reduce project timelines.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky RFQ Bar -->
    <div
      class="from-primary pointer-events-none fixed bottom-0 left-0 right-0 z-[100] bg-gradient-to-t to-transparent p-6"
    >
      <div class="pointer-events-auto mx-auto max-w-4xl">
        <div
          class="bg-secondary/90 border-tertiary/20 flex flex-col items-center justify-between gap-4 rounded-2xl border p-4 shadow-2xl backdrop-blur-xl sm:flex-row"
        >
          <div class="hidden sm:block">
            <div class="text-sm font-bold text-white">Sourcing Saudi Lab Capabilities?</div>
            <div class="text-text-secondary text-xs">
              Request technical proposals from our verified network.
            </div>
          </div>
          <div class="flex w-full gap-3 sm:w-auto">
            <a
              href="#rfq"
              class="bg-tertiary text-primary flex-1 rounded-xl px-6 py-2.5 text-center text-sm font-black transition-all hover:bg-yellow-600 sm:flex-none"
            >
              Submit Regional RFQ
            </a>
            <a
              href="/search/standards?region=Saudi+Arabia"
              class="flex-1 rounded-xl border border-white/10 bg-white/5 px-6 py-2.5 text-center text-sm font-bold text-white transition-all hover:bg-white/10 sm:flex-none"
            >
              Global Directory
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Modals -->
    <ContactLabModal client:only="react" />

    <Footer />
  </div>
</BaseLayout>

<style is:global>
  body {
    background: #0a0a0b !important;
  }

  .animate-fade-up {
    animation: fade-up 0.5s ease-out forwards;
    opacity: 0;
  }

  .delay-100 {
    animation-delay: 0.1s;
  }
  .delay-200 {
    animation-delay: 0.2s;
  }
  .delay-300 {
    animation-delay: 0.3s;
  }
  .delay-400 {
    animation-delay: 0.4s;
  }
  .delay-500 {
    animation-delay: 0.5s;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
