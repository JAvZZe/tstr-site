---
// src/pages/company/[slug].astro
import { supabase } from '../../lib/supabase';
import NewsletterBanner from '../../components/NewsletterBanner';
import Footer from '../../components/Footer.astro';
import ComplianceMatrix from '../../components/ComplianceMatrix';
import TrustBadge from '../../components/TrustBadge';
import { getRedirectUrl } from '../../lib/redirect';
import { formatTitle, formatDescription } from '../../lib/seo';

// 1. SSR Edge Caching
Astro.response.headers.set('Cache-Control', 's-maxage=86400, stale-while-revalidate=3600');

const { slug } = Astro.params;

// 2. Fetch company data
const { data: listing, error } = await supabase
  .from('listings')
  .select(
    `
    *,
    location:location_id (id, name, slug),
    capabilities:listing_capabilities (
      id,
      verified,
      notes,
      standard:standard_id (id, code, name, description)
    ),
    parent:parent_listing_id (id, business_name, slug)
  `
  )
  .eq('slug', slug)
  .single();

if (!listing || error) {
  return Astro.redirect('/404');
}

const pageTitle = formatTitle([listing.business_name, 'Testing Services']);
const pageDescription = formatDescription(
  `${listing.business_name} provides testing services in ${listing.location?.name || listing.region}. See its certifications, equipment, and how to request quotes.`
);

// 3. Structured data for GEO/AEO (entity clarity + answer-extractability)
const standards = (listing.capabilities || [])
  .map((c: any) => c.standard?.name || c.standard?.code)
  .filter(Boolean);
const regionName = listing.location?.name || listing.region || '';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: listing.business_name,
    description: listing.description || pageDescription,
    url: `https://tstr.directory/company/${listing.slug}`,
    areaServed: regionName,
    address: regionName ? { '@type': 'PostalAddress', addressRegion: regionName } : undefined,
    knowsAbout: standards.length ? standards : undefined,
    sameAs: listing.website || undefined,
    ...(listing.website
      ? { url: `https://tstr.directory/company/${listing.slug}`, sameAs: listing.website }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `What testing services does ${listing.business_name} offer?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${listing.business_name} is a testing laboratory in ${regionName || 'its region'}${standards.length ? ` offering ${standards.slice(0, 5).join(', ')}${standards.length > 5 ? ', and more' : ''} testing and certification` : ' offering verification and compliance testing'}.`,
        },
      },
      {
        '@type': 'Question',
        name: `How do I verify ${listing.business_name}'s accreditations?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Check the lab's scope against the body that accredited it, such as ISO/IEC 17025. TSTR.directory lists the standards a lab has supplied, and leaves the field blank where nothing has been supplied. Ask the laboratory for the certificate itself to confirm.`,
        },
      },
      {
        '@type': 'Question',
        name: `Where is ${listing.business_name} located?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${listing.business_name} is located in ${regionName || 'its listed region'}. Contact the lab via TSTR.directory to discuss testing requirements and turnaround times.`,
        },
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-screen bg-gray-50 font-sans text-gray-900">
    <NewsletterBanner client:only="react" />

    <nav class="sticky top-0 z-10 bg-white p-4 shadow-sm">
      <div class="mx-auto flex max-w-6xl items-center justify-between">
        <a href="/" class="text-xl font-bold">TSTR<span class="text-blue-600">.directory</span></a>
        {
          listing.website && (
            <a
              href={getRedirectUrl(listing.website, listing.id)}
              class="rounded bg-blue-600 px-4 py-2 font-bold text-white transition hover:bg-blue-700"
            >
              Visit Website
            </a>
          )
        }
      </div>
    </nav>

    <main class="mx-auto max-w-5xl p-6">
      <!-- Breadcrumbs -->
      <div class="mb-6 text-sm text-gray-500">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span class="mx-2">›</span>
        {
          listing.parent && (
            <>
              <a href={`/group/${listing.parent.slug}`} class="hover:text-blue-600">
                {listing.parent.business_name}
              </a>
              <span class="mx-2">›</span>
            </>
          )
        }
        <span class="font-medium text-gray-900">{listing.business_name}</span>
      </div>

      <!-- Hero Header -->
      <div
        class="relative mb-8 overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-sm"
      >
        <div class="absolute right-0 top-0 p-4">
          <TrustBadge
            level={listing.verified ? 'verified' : listing.claimed ? 'claimed' : 'aggregated'}
            size="lg"
          />
        </div>

        <div class="flex flex-col items-start justify-between gap-6 md:flex-row">
          <div class="flex-1">
            <h1 class="mb-3 text-4xl font-black tracking-tight text-blue-900 md:text-5xl">
              {listing.business_name}
            </h1>
            <p class="mb-6 flex items-center gap-2 text-xl font-medium text-gray-600">
              📍 {listing.location?.name}, {listing.region?.toUpperCase()}
            </p>
            <div class="prose prose-blue max-w-3xl text-lg leading-relaxed text-gray-700">
              {listing.description}
            </div>
          </div>
        </div>
      </div>

      <!-- Accreditations Section -->
      <section id="certifications" class="mb-16 scroll-mt-32">
        <div class="mb-8 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-xl">
            📜
          </div>
          <h2 class="text-3xl font-black tracking-tight text-gray-900">Standards and compliance</h2>
        </div>

        <ComplianceMatrix capabilities={listing.capabilities} />
      </section>

      <!-- Contact CTA -->
      <div
        id="contact"
        class="relative mb-12 overflow-hidden rounded-3xl bg-gradient-to-br from-blue-900 to-indigo-950 p-12 text-center text-white shadow-2xl"
      >
        <h2 class="z-1 relative mb-4 text-4xl font-black">
          Request technical data from {listing.business_name}
        </h2>
        <p class="z-1 relative mx-auto mb-10 max-w-2xl text-xl text-blue-100">
          Discuss specialized testing requirements, get turnaround times, and receive verified
          quotes within 24 hours.
        </p>

        <button
          class="z-1 relative transform rounded-2xl bg-white px-12 py-5 text-2xl font-black text-blue-900 shadow-lg transition-all hover:scale-105 hover:bg-blue-50 active:scale-95"
        >
          Contact This Laboratory
        </button>
      </div>
      <!-- FAQ (GEO/AEO: answer-extractable, cited by AI assistants) -->
      <section id="faq" class="mb-16 scroll-mt-32">
        <div class="mb-8 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-xl">
            ❓
          </div>
          <h2 class="text-3xl font-black tracking-tight text-gray-900">
            Frequently Asked Questions
          </h2>
        </div>
        <div class="space-y-4">
          <details class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer text-lg font-bold"
              >What testing services does {listing.business_name} offer?</summary
            >
            <p class="mt-3 leading-relaxed text-gray-700">
              {listing.business_name} is a testing laboratory in {regionName || 'its region'}{
                standards.length
                  ? ` offering ${standards.slice(0, 5).join(', ')}${standards.length > 5 ? ', and more' : ''} testing and certification`
                  : ' offering verification and compliance testing'
              }.
            </p>
          </details>
          <details class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer text-lg font-bold"
              >How do I verify {listing.business_name}'s accreditations?</summary
            >
            <p class="mt-3 leading-relaxed text-gray-700">
              Check the lab's scope against its accreditation body (e.g. ISO/IEC 17025).
              TSTR.directory shows the verified compliance matrix and standards the lab is
              accredited for; request the certificate directly from the laboratory for formal
              confirmation.
            </p>
          </details>
          <details class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer text-lg font-bold"
              >Where is {listing.business_name} located?</summary
            >
            <p class="mt-3 leading-relaxed text-gray-700">
              {listing.business_name} is located in {regionName || 'its listed region'}. Contact the
              lab via TSTR.directory to discuss testing requirements and turnaround times.
            </p>
          </details>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
