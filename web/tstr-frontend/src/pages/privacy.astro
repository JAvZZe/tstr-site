---
// Privacy Policy page
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACTS } from '../lib/contacts';
import Footer from '../components/Footer.astro';
import { formatTitle, formatDescription } from '../lib/seo';
---

<BaseLayout
  title={formatTitle(['Privacy Policy - TSTR Hub'])}
  description={formatDescription('How we collect, use, and protect your information')}
>
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7003918988204966"
        crossorigin="anonymous"></script>
      <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }

        body {
          font-family:
            -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell,
            sans-serif;
          line-height: 1.6;
          color: #333;
          background: #f5f5f5;
        }

        header {
          background: linear-gradient(135deg, #000080 0%, #32cd32 100%);
          color: white;
          padding: 3rem 2rem;
          text-align: center;
        }

        header h1 {
          font-size: 2.5rem;
          margin-bottom: 0.5rem;
          font-weight: 700;
        }

        header p {
          font-size: 1.1rem;
          opacity: 0.95;
        }

        main {
          max-width: 900px;
          margin: 0 auto;
          padding: 3rem 2rem;
        }

        .content {
          background: white;
          border-radius: 12px;
          padding: 3rem;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .back-link {
          display: inline-block;
          margin-bottom: 2rem;
          color: #000080;
          text-decoration: none;
          font-weight: 600;
          transition: color 0.3s ease;
        }

        .back-link:hover {
          color: #32cd32;
        }

        h2 {
          color: #000080;
          font-size: 1.75rem;
          margin-top: 2rem;
          margin-bottom: 1rem;
          padding-bottom: 0.5rem;
          border-bottom: 2px solid #000080;
        }

        h3 {
          color: #555;
          font-size: 1.25rem;
          margin-top: 1.5rem;
          margin-bottom: 0.75rem;
        }

        p,
        li {
          margin-bottom: 1rem;
          color: #555;
          line-height: 1.8;
        }

        ul {
          margin-left: 2rem;
          margin-bottom: 1.5rem;
        }

        li {
          margin-bottom: 0.5rem;
        }

        .effective-date {
          background: #f0f0f0;
          padding: 1rem;
          border-radius: 8px;
          margin-bottom: 2rem;
          font-weight: 600;
          color: #000080;
        }

        .contact-box {
          background: #f5f7fa;
          border-left: 4px solid #000080;
          padding: 1.5rem;
          margin-top: 2rem;
          border-radius: 4px;
        }

        .contact-box strong {
          color: #000080;
        }

        a {
          color: #000080;
          text-decoration: none;
        }

        a:hover {
          text-decoration: underline;
        }

        footer {
          background: #333;
          color: white;
          text-align: center;
          padding: 2rem;
          margin-top: 3rem;
        }

        footer a {
          color: white;
          margin: 0 1rem;
        }
      </style>
      <script>
        function initApollo() {
          var n = Math.random().toString(36).substring(7),
            o = document.createElement('script');
          ((o.src = 'https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache=' + n),
            (o.async = !0),
            (o.defer = !0),
            (o.onload = function () {
              window.trackingFunctions.onLoad({ appId: '6979e8021ac917001927e9b2' });
            }),
            document.head.appendChild(o));
        }
        initApollo();
      </script>
    </head>
    <body>
      <header>
        <h1>Privacy Policy</h1>
        <p>How we collect, use, and protect your information</p>
      </header>

      <main>
        <a href="/" class="back-link">← Back to Directory</a>

        <div class="content">
          <div class="effective-date">Effective Date: October 29, 2025</div>

          <p>
            This page explains what TSTR Hub does with your information when you use <a
              href="https://tstr.directory">tstr.directory</a
            >. "We" and "us" mean TSTR Hub.
          </p>

          <p>Please read it. If you're not comfortable with what's here, don't use the site.</p>

          <h2>1. What we collect</h2>

          <h3>1.1 Things you give us</h3>
          <p>Some information only reaches us because you send it:</p>
          <ul>
            <li>
              <strong>Company listings:</strong> business name, category, website, email address, phone
              number, address, and a description of what the company does
            </li>
            <li>
              <strong>Contact details:</strong> your email address, when you write to us
            </li>
          </ul>

          <h3>1.2 Things collected automatically</h3>
          <p>Visiting the site leaves a technical trace, as it does on any website:</p>
          <ul>
            <li>
              <strong>Log data:</strong> IP address, browser, operating system, the page you came from,
              the pages you looked at, and how long you stayed
            </li>
            <li>
              <strong>Cookies:</strong> small files stored by your browser. Section 3 covers these
            </li>
          </ul>

          <h2>2. What we do with it</h2>

          <p>We use this information to:</p>
          <ul>
            <li>
              <strong>Run the directory:</strong> show company listings to people looking for testing
              services
            </li>
            <li>
              <strong>Reply to you:</strong> answer questions and help with problems
            </li>
            <li>
              <strong>Improve the site:</strong> see which parts get used and which don't
            </li>
            <li><strong>Meet legal obligations:</strong> comply with the law</li>
            <li>
              <strong>Show adverts:</strong> through third-party advertising partners
            </li>
          </ul>

          <h2>3. Cookies</h2>

          <p>
            Cookies are small files your browser stores. We use them to keep the site working and to
            see how it's used.
          </p>

          <h3>The kinds we use</h3>
          <ul>
            <li>
              <strong>Essential:</strong> without these the site doesn't work properly
            </li>
            <li>
              <strong>Analytics:</strong> these show us how visitors move around the site
            </li>
            <li>
              <strong>Advertising:</strong> these help deliver relevant adverts, through Google AdSense
            </li>
          </ul>

          <p>
            Your browser can refuse cookies, or warn you each time one is set. Refusing them may
            stop parts of the site working.
          </p>

          <h2>4. Other companies involved</h2>

          <p>Running the site means using a few outside services, which may collect information:</p>

          <h3>4.1 Supabase, our database</h3>
          <p>
            Supabase stores the company listings and account data. It complies with GDPR. See the <a
              href="https://supabase.com/privacy"
              target="_blank">Supabase privacy policy</a
            >.
          </p>

          <h3>4.2 Google AdSense, advertising</h3>
          <p>
            Google AdSense shows adverts on the site. Google uses cookies to choose adverts based on
            pages you've visited here and elsewhere. To turn off personalised advertising, use <a
              href="https://www.google.com/settings/ads"
              target="_blank">Google Ads Settings</a
            >.
          </p>
          <p>
            Learn more: <a href="https://policies.google.com/technologies/ads" target="_blank"
              >Google Advertising Privacy Policy</a
            >
          </p>

          <h3>4.3 Cloudflare (Hosting & CDN)</h3>
          <p>
            Our website is hosted on Cloudflare Pages, which may collect certain technical
            information for security and performance purposes. Learn more: <a
              href="https://www.cloudflare.com/privacypolicy/"
              target="_blank">Cloudflare Privacy Policy</a
            >
          </p>

          <h2>5. Who else sees it</h2>

          <p>Your information goes further than us in these situations:</p>
          <ul>
            <li>
              <strong>The public directory:</strong> a listing you submit is published on the site for
              anyone to read
            </li>
            <li>
              <strong>Suppliers:</strong> the companies that host the site, run the database, and provide
              analytics
            </li>
            <li>
              <strong>Analytics tools:</strong> if you accept the cookie banner, we load Apollo.io for
              visitor identification and a cookie-free analytics tool that shows us which labs and standards
              people search for. Neither loads until you accept. Clear your site data to withdraw that
              consent
            </li>
            <li>
              <strong>Legal requests:</strong> where the law requires it, or in response to a valid legal
              request
            </li>
            <li>
              <strong>A sale of the business:</strong> if TSTR Hub is merged, acquired, or sold, your
              information may transfer with it
            </li>
          </ul>

          <p><strong>We don't sell your personal information.</strong></p>

          <h2>6. Keeping it safe</h2>

          <p>
            We use technical and organisational measures to protect your information from
            unauthorised access, alteration, and loss. No system is perfectly secure, and we won't
            pretend otherwise.
          </p>

          <h2>7. Your rights</h2>

          <h3>7.1 Rights everyone has</h3>
          <p>You can ask us to:</p>
          <ul>
            <li>
              <strong>Show you:</strong> a copy of the personal information we hold about you
            </li>
            <li>
              <strong>Correct it:</strong> fix anything wrong or incomplete
            </li>
            <li><strong>Delete it:</strong> remove your personal information</li>
            <li><strong>Stop:</strong> object to how we're processing it</li>
            <li><strong>Move it:</strong> transfer your data to another service</li>
          </ul>

          <h3>7.2 If you're in Europe</h3>
          <p>In the European Economic Area, GDPR gives you more:</p>
          <ul>
            <li>Withdraw consent whenever you like</li>
            <li>Complain to your data protection authority</li>
            <li>Ask us to restrict processing</li>
          </ul>

          <h3>7.3 If you're in California</h3>
          <p>California residents have rights under the CCPA:</p>
          <ul>
            <li>Know what personal information we collect</li>
            <li>Know whether it's sold or shared</li>
            <li>Opt out of its sale</li>
            <li>Not be treated differently for exercising these rights</li>
          </ul>

          <p>
            <strong>For the record:</strong> we don't sell personal information as the CCPA defines it.
          </p>

          <h3>7.4 Using these rights</h3>
          <p>Contact us using the details in section 11 and tell us what you want.</p>

          <h2>8. How long we keep it</h2>

          <p>
            We keep your information for as long as it's needed for the reasons set out here, unless
            the law requires us to keep it longer.
          </p>

          <ul>
            <li>
              <strong>Company listings:</strong> while the listing is active, then 2 years after it's
              deleted
            </li>
            <li><strong>Log data:</strong> up to 90 days</li>
            <li>
              <strong>Cookies:</strong> this varies by type. Your browser settings control them
            </li>
          </ul>

          <h2>9. Children</h2>

          <p>
            This site is for people doing business, not children. We don't knowingly collect
            information from anyone under 13, or under 16 in the EEA. If your child has sent us
            something, tell us and we'll delete it.
          </p>

          <h2>10. Where your data goes</h2>

          <p>
            Your information may be processed in countries other than the one you live in, and their
            data protection laws may differ from yours.
          </p>

          <p>
            Where that happens, we put safeguards in place as the applicable data protection law
            requires.
          </p>

          <h2>11. Changes to this policy</h2>

          <p>
            We may update this policy. When we do, the new version goes on this page and the
            effective date at the top changes.
          </p>

          <p>Worth checking back occasionally. Changes take effect once they're posted here.</p>

          <h2>12. Contact us</h2>

          <div class="contact-box">
            <p>
              <strong>Questions about privacy, or want your data removed? Get in touch:</strong>
            </p>
            <p>
              <strong>Contact form:</strong>
              <a href="/contact?inquiry=general&subject=Privacy%20Policy%20Inquiry"
                >https://tstr.directory/contact</a
              ><br />
              <strong>Website:</strong>
              <a href="https://tstr.directory">https://tstr.directory</a>
            </p>
            <p style="margin-top: 1rem; font-size: 0.95rem; color: #666;">
              Use the same form to ask about a listing, or to have your company listing taken down.
            </p>
          </div>

          <h2>13. Opting out</h2>

          <h3>Advertising</h3>
          <ul>
            <li>
              Google Ads: <a href="https://www.google.com/settings/ads" target="_blank"
                >https://www.google.com/settings/ads</a
              >
            </li>
            <li>
              Network Advertising Initiative: <a
                href="http://www.networkadvertising.org/choices/"
                target="_blank">http://www.networkadvertising.org/choices/</a
              >
            </li>
            <li>
              Digital Advertising Alliance: <a
                href="http://www.aboutads.info/choices/"
                target="_blank">http://www.aboutads.info/choices/</a
              >
            </li>
          </ul>

          <h3>Cookies</h3>
          <p>Most browsers let you manage cookies in their settings:</p>
          <ul>
            <li>
              Chrome: <a href="https://support.google.com/chrome/answer/95647" target="_blank"
                >Cookie Settings</a
              >
            </li>
            <li>
              Firefox: <a
                href="https://support.mozilla.org/en-US/kb/cookies-information-websites-store-on-your-computer"
                target="_blank">Cookie Settings</a
              >
            </li>
            <li>
              Safari: <a
                href="https://support.apple.com/guide/safari/manage-cookies-and-website-data-sfri11471/mac"
                target="_blank">Cookie Settings</a
              >
            </li>
            <li>
              Edge: <a
                href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09"
                target="_blank">Cookie Settings</a
              >
            </li>
          </ul>
        </div>
      </main>
    </body>
  </html>
</BaseLayout>
