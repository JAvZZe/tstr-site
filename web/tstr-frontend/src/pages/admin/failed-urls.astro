---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Force SSR shell
export const prerender = false;
---

<AdminLayout title="Failed URL Validations">
  <div id="loading" class="flex min-h-[50vh] items-center justify-center">
    <div class="text-center">
      <svg
        class="mx-auto mb-4 h-10 w-10 animate-spin text-blue-500"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
        ></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <p class="text-lg text-gray-500">Loading Validation Data...</p>
    </div>
  </div>

  <div id="content" class="hidden">
    <div class="mb-8 flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900">Failed URL Validations</h1>
      <div>
        <a
          href="/admin/dashboard"
          class="mr-4 text-sm font-medium text-blue-600 hover:text-blue-800">← Dashboard</a
        >
        <button
          id="refresh-btn"
          class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
          >Refresh</button
        >
      </div>
    </div>

    <div class="mb-8 overflow-hidden rounded-lg bg-white shadow-md">
      <div class="border-b border-gray-200 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-800" id="table-title">Failed URL Management</h2>
        <div class="mt-2 flex gap-4 text-sm" id="summary-stats">
          <span class="text-gray-500">Calculating...</span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                >Status</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                >Business</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                >URL</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                >Error</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                >Date</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                >Actions</th
              >
            </tr>
          </thead>
          <tbody id="failed-urls-table" class="divide-y divide-gray-200 bg-white">
            <!-- Populated via JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Guide -->
    <div class="rounded-lg border border-blue-200 bg-blue-50 p-6">
      <h3 class="mb-3 text-lg font-semibold text-blue-800">Correction Process</h3>
      <div class="grid grid-cols-1 gap-4 space-y-2 text-sm text-blue-700 md:grid-cols-2">
        <div>
          <p><strong>1. Verify:</strong> Test the URL manually.</p>
          <p><strong>2. Search:</strong> Find the correct company website.</p>
          <p><strong>3. Fix:</strong> Add the corrected listing to the DB.</p>
        </div>
        <div>
          <p>
            <strong>4. Status:</strong> Will turn <span class="font-bold text-green-700">Green</span
            > here once fixed.
          </p>
          <p><strong>5. Clean:</strong> This list auto-cleans periodically.</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabaseBrowser } from '../../lib/supabase-browser';

  async function loadData() {
    const loading = document.getElementById('loading');
    const content = document.getElementById('content');
    const tbody = document.getElementById('failed-urls-table');

    try {
      // 1. Auth Check
      const {
        data: { session },
      } = await supabaseBrowser.auth.getSession();
      if (!session) {
        window.location.href = '/admin/login';
        return;
      }

      // 2. Fetch Data
      const res = await fetch('/api/admin/failed-urls', {
        headers: { Authorization: `Bearer ${session.access_token}` },
      });

      if (!res.ok) throw new Error('Failed to load data');

      const { failedUrls, correctedUrls } = await res.json();

      // 3. Render Table
      if (!failedUrls || failedUrls.length === 0) {
        tbody.innerHTML =
          '<tr><td colspan="6" class="px-6 py-12 text-center text-gray-500">No failed validations found. Great job!</td></tr>';
      } else {
        tbody.innerHTML = failedUrls
          .map((item) => {
            const isCorrected = correctedUrls.includes(item.website);
            return `
                        <tr class="hover:bg-gray-50 ${isCorrected ? 'bg-green-50' : ''}">
                          <td class="px-6 py-4 whitespace-nowrap">
                            ${
                              isCorrected
                                ? '<span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">Corrected</span>'
                                : '<span class="px-2 py-1 bg-red-100 text-red-800 rounded-full text-xs font-medium">Failed</span>'
                            }
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap">
                             <div class="text-sm font-medium text-gray-900">${item.business_name || 'Unknown'}</div>
                          </td>
                           <td class="px-6 py-4 whitespace-nowrap">
                             <div class="text-sm text-gray-500 truncate max-w-xs" title="${item.website}">${item.website || 'N/A'}</div>
                          </td>
                           <td class="px-6 py-4 whitespace-nowrap">
                             <span class="text-xs text-red-600 block max-w-xs truncate" title="${item.validation_error || ''}">
                                ${item.validation_error || 'Unknown Error'}
                             </span>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            ${new Date(item.created_at).toLocaleDateString()}
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            ${
                              item.website
                                ? `
                                <a href="${item.website}" target="_blank" class="text-blue-600 hover:text-blue-900 mr-3">Test</a>
                                <button class="text-green-600 hover:text-green-900 copy-btn" data-url="${item.website}">Copy</button>
                            `
                                : ''
                            }
                          </td>
                        </tr>
                     `;
          })
          .join('');
      }

      // 4. Update Stats
      const correctedCount = correctedUrls.length;
      const failedCount = (failedUrls?.length || 0) - correctedCount;
      document.getElementById('summary-stats').innerHTML = `
                <span class="text-green-600 font-bold">Corrected: ${correctedCount}</span>
                <span class="text-red-600 font-bold ml-4">Pending: ${failedCount}</span>
            `;
      document.getElementById('table-title').textContent =
        `Failed URL Management (${failedUrls?.length || 0})`;

      // Copy Handler
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const url = e.target.getAttribute('data-url');
          navigator.clipboard.writeText(url);
          const originalText = e.target.textContent;
          e.target.textContent = 'Copied!';
          setTimeout(() => (e.target.textContent = originalText), 1000);
        });
      });

      loading.classList.add('hidden');
      content.classList.remove('hidden');
    } catch (e) {
      console.error(e);
      loading.innerHTML = `<p class="text-red-500">Error: ${e.message}</p>`;
    }
  }

  document.getElementById('refresh-btn')?.addEventListener('click', loadData);

  // Init
  loadData();
</script>
