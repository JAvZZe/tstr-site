---
// src/pages/[category]/[standard]/[region]/index.astro
import { supabase } from '../../../../lib/supabase';
import NewsletterBanner from '../../../../components/NewsletterBanner';
import Footer from '../../../../components/Footer.astro';
import TrustBadge from '../../../../components/TrustBadge';
import SeoJsonLd from '../../../../components/SeoJsonLd.astro';
import { getRedirectUrl } from '../../../../lib/redirect';
import { formatTitle, formatDescription } from '../../../../lib/seo';

// 1. SSR Edge Caching
Astro.response.headers.set('Cache-Control', 's-maxage=86400, stale-while-revalidate=3600');

const { category, standard, region } = Astro.params;

// 2. Fetch Aggregated Data
const { data: pageData, error } = await supabase
  .from('listings')
  .select(
    `
    id,
    business_name,
    slug,
    description,
    region,
    verified,
    claimed,
    website,
    location:location_id (name),
    listing_categories!inner (category:category_id (name, slug)),
    listing_capabilities!inner (
      verified,
      standard:standard_id!inner (code, name)
    )
  `
  )
  .eq('status', 'active')
  .eq('listing_categories.category.slug', category)
  .eq('listing_capabilities.standard.code', standard)
  .eq('region', region === 'global' ? undefined : region);

if (error || !pageData) {
  return Astro.redirect('/404');
}

const standardName = pageData[0]?.listing_capabilities[0]?.standard.name || standard;
const categoryName = pageData[0]?.listing_categories[0]?.category.name || category;
const regionTitle = region.toUpperCase();

const pageTitle = formatTitle([`${standard} ${categoryName}`, regionTitle]);
const pageDescription = formatDescription(
  `Find ${pageData.length} laboratories listing ${standard} (${standardName}) capability in ${regionTitle}. Compare providers for ${categoryName.toLowerCase()} work.`
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: `${standard} ${categoryName} in ${regionTitle}`,
        description: pageDescription,
        url: `https://tstr.directory/${category}/${standard}/${region}`,
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: pageData.length,
          itemListElement: pageData.slice(0, 20).map((l, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: `https://tstr.directory/listing/${l.slug}`,
            name: l.business_name,
          })),
        },
      })}
    />
  </head>

  <body class="min-h-screen bg-gray-50 font-sans text-gray-900">
    <NewsletterBanner client:only="react" />
    <nav class="bg-white p-4 shadow-sm">
      <div class="mx-auto max-w-6xl">
        <a href="/" class="text-xl font-black transition hover:text-blue-600"
          >TSTR<span class="text-blue-600">.directory</span></a
        >
      </div>
    </nav>

    <main class="mx-auto max-w-5xl p-6">
      <div class="mb-12">
        <h1 class="mb-4 text-4xl font-black tracking-tight text-blue-900 md:text-6xl">
          {standard} Labs in {regionTitle}
        </h1>
      </div>

      <div class="mb-12 grid gap-6">
        {
          pageData.map((listing) => (
            <div class="group rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all hover:shadow-lg">
              <div class="flex flex-col items-start justify-between gap-6 md:flex-row">
                <div class="flex-1">
                  <div class="mb-2 flex items-center gap-3">
                    <h3 class="text-2xl font-black text-blue-900 transition-colors group-hover:text-blue-600">
                      {listing.business_name}
                    </h3>
                    <TrustBadge
                      level={
                        listing.verified ? 'verified' : listing.claimed ? 'claimed' : 'aggregated'
                      }
                      size="sm"
                    />
                  </div>
                  <p class="mb-4 line-clamp-2 leading-relaxed text-gray-700">
                    {listing.description}
                  </p>
                </div>

                <div class="flex w-full flex-col gap-3 md:w-auto">
                  <a
                    href={`/company/${listing.slug}`}
                    class="rounded-xl border-2 border-blue-900 px-6 py-3 text-center font-black text-blue-900 transition-all hover:bg-blue-900 hover:text-white"
                  >
                    View Full Scope
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </main>

    <Footer />
  </body>
</html>
