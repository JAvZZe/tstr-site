---
const title = 'Page Not Found | TSTR.directory';
const layout = '../layouts/BaseLayout.astro';
---

<div
  class="flex min-h-screen items-center justify-center bg-gradient-to-br from-gray-50 to-blue-50 p-4"
>
  <div class="w-full max-w-md text-center">
    <div class="rounded-2xl bg-white p-8 shadow-xl">
      <div class="mb-4 text-6xl font-bold text-gray-300">404</div>
      <h1 class="mb-2 text-2xl font-bold text-gray-900">Page Not Found</h1>
      <p class="mb-6 text-gray-600">The page you're looking for doesn't exist or has been moved.</p>
      <a
        href="/"
        class="inline-block rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white transition duration-200 hover:bg-blue-700"
      >
        Go to Homepage
      </a>
    </div>
  </div>
</div>

<style>
  body {
    margin: 0;
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans',
      'Helvetica Neue', sans-serif;
  }
</style>
