---
import { supabase } from '../lib/supabase';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import StandardMatrix from '../components/StandardMatrix';
import ContactLabModal from '../components/ContactLabModal';

// Hydrogen Category IDs
const CATEGORY_IDS = [
  '2817126e-65fa-4ddf-8ec6-dbedb021001a', // Hydrogen Infrastructure
  'f29966a2-4753-451b-b354-d756c78a8d38', // Hydrogen Embrittlement
  '508b108a-5563-4287-9078-0f8f1310951f', // Hydrogen Purity
];

// Fetch all standards for these categories
const { data: h2Standards, error: standardsError } = await supabase
  .from('standards')
  .select('id, code, name, description, category_id')
  .in('category_id', CATEGORY_IDS)
  .eq('is_active', true)
  .order('code');

// Primary Labs for the Matrix (to ensure a premium first look)
const PRIMARY_LAB_IDS = [
  'a837f837-5b02-4c04-a0e8-546316067587', // TÜV SÜD
  'ca82073a-b4fa-4bcd-b7e4-750fe14b52dc', // Powertech Labs
  'a302f6e3-4222-4dce-adcd-746dbb5dc4a2', // Element Materials Technology
  '77f22044-a7f5-48e7-bc2d-c726dc3c4324', // Kiwa Technology
  'e6a55e77-91ad-44ab-be5b-54c951861359', // SGS
  'b0282601-6df0-48a8-9eaf-1feb7634195c', // WHA International
];

// Fetch lab data and capabilities for the matrix
const { data: labsData, error: labsError } = await supabase
  .from('listings')
  .select(
    `
    id, 
    business_name,
    listing_capabilities(standard_id)
  `
  )
  .in('id', PRIMARY_LAB_IDS);

const matrixLabs =
  labsData?.map((lab) => ({
    id: lab.id,
    business_name: lab.business_name,
    capabilities: lab.listing_capabilities.map((c) => c.standard_id),
  })) || [];

// Category stats
const h2StandardIds = h2Standards?.map((s) => s.id) || [];
let uniqueLabCount = 0;
if (h2StandardIds.length > 0) {
  const { data: totalLabs, error: totalError } = await supabase
    .from('listing_capabilities')
    .select('listing_id')
    .in('standard_id', h2StandardIds);
  uniqueLabCount = new Set(totalLabs?.map((l) => l.listing_id) || []).size;
}

const title = 'Hydrogen Testing Hub | ISO 19880-3 & 700 Bar Certification';
const description =
  'The global directory for hydrogen infrastructure testing. Compare labs for ISO 19880-3, SAE J2601, and material compatibility. High-pressure (700 bar) and cryogenic specialists.';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen overflow-x-hidden bg-[#020203] text-white selection:bg-blue-500/30">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-6 pb-20 pt-24">
      <div class="absolute inset-0 z-0 text-white">
        <div
          class="absolute left-[-10%] top-[-10%] h-[40%] w-[40%] rounded-full bg-blue-600/10 blur-[120px]"
        >
        </div>
        <div
          class="absolute bottom-[-10%] right-[-10%] h-[40%] w-[40%] rounded-full bg-emerald-600/10 blur-[120px]"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl text-center">
        <div
          class="animate-fade-up mb-8 inline-flex items-center rounded-full border border-blue-500/30 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-blue-400"
        >
          <span class="relative mr-3 flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-500"></span>
          </span>
          Technical Infrastructure Directory
        </div>

        <h1
          class="animate-fade-up mb-8 text-5xl font-black leading-none tracking-tighter delay-100 md:text-7xl"
        >
          The <span
            class="bg-gradient-to-r from-blue-400 to-emerald-400 bg-clip-text text-transparent"
            >Hydrogen Premium</span
          > Hub
        </h1>

        <p
          class="animate-fade-up mx-auto mb-12 max-w-2xl text-lg font-medium text-slate-400 delay-200 md:text-xl"
        >
          Global access to high-velocity labs for ISO 19880-3, SAE J2601, and cryogenic hydrogen
          infrastructure certification.
        </p>

        <div
          class="animate-fade-up flex flex-col items-center justify-center gap-4 delay-300 sm:flex-row"
        >
          <a
            href="#matrix"
            class="rounded-xl bg-blue-600 px-8 py-4 font-bold text-white shadow-xl shadow-blue-900/20 transition-all hover:bg-blue-500 active:scale-95"
          >
            Compare Laboratories
          </a>
          <a
            href="#rfq"
            class="rounded-xl border border-white/10 bg-white/5 px-8 py-4 font-bold text-white transition-all hover:bg-white/10 active:scale-95"
          >
            Submit Technical RFQ
          </a>
        </div>

        <div
          class="animate-fade-up delay-400 mt-20 grid grid-cols-2 gap-8 border-t border-white/5 pt-10 md:grid-cols-4"
        >
          <div>
            <div class="text-3xl font-black text-white">{uniqueLabCount}</div>
            <div class="mt-1 text-[10px] uppercase tracking-widest text-slate-500">
              Specialist Facilities
            </div>
          </div>
          <div>
            <div class="text-3xl font-black text-white">{h2Standards?.length || 15}</div>
            <div class="mt-1 text-[10px] uppercase tracking-widest text-slate-500">
              H2 Standards
            </div>
          </div>
          <div>
            <div class="text-3xl font-black text-white">700</div>
            <div class="mt-1 text-[10px] uppercase tracking-widest text-slate-500">
              Bar Capability
            </div>
          </div>
          <div>
            <div class="text-3xl font-black text-white">-253</div>
            <div class="mt-1 text-[10px] uppercase tracking-widest text-slate-500">
              °C Liquid State
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Matrix -->
    <section id="matrix" class="relative px-6 py-24">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16">
          <h2 class="mb-4 text-3xl font-black">Technical Comparison Matrix</h2>
          <p class="max-w-xl text-slate-400">
            Mapping Tier-1 laboratories across mission-critical hydrogen infrastructure standards.
          </p>
        </div>

        <div class="animate-fade-up delay-500">
          <StandardMatrix
            client:load
            standards={h2Standards?.slice(0, 15) || []}
            labs={matrixLabs}
          />
        </div>

        <p class="mt-8 text-xs italic text-slate-500">
          * Data based on verified laboratory accreditation and project history.
        </p>
      </div>
    </section>

    <!-- Category Tree -->
    <section class="bg-[#050507] px-6 py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <!-- Infrastructure -->
          <div
            class="group rounded-3xl border border-white/5 bg-white/5 p-8 backdrop-blur-sm transition-all hover:border-blue-500/30"
          >
            <div
              class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-blue-500/20 bg-blue-500/10"
            >
              <svg
                class="h-6 w-6 text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </div>
            <h3 class="mb-4 text-xl font-bold">Hydrogen Infrastructure</h3>
            <p class="mb-6 text-sm leading-relaxed text-slate-400">
              Valve testing (ISO 19880-3), refueling standards (SAE J2601), and dispenser
              certification for 350/700 bar systems.
            </p>
            <a
              href="/search/standards?category=Infrastructure"
              class="flex items-center text-sm font-bold text-blue-400 transition-all group-hover:gap-2"
            >
              Browse Standards <span class="ml-1">→</span>
            </a>
          </div>

          <!-- Embrittlement -->
          <div
            class="group rounded-3xl border border-white/5 bg-white/5 p-8 backdrop-blur-sm transition-all hover:border-emerald-500/30"
          >
            <div
              class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-500/20 bg-emerald-500/10"
            >
              <svg
                class="h-6 w-6 text-emerald-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="mb-4 text-xl font-bold">Material Compatibility</h3>
            <p class="mb-6 text-sm leading-relaxed text-slate-400">
              Analyzing hydrogen-assisted fatigue and embrittlement (ASTM G142, ISO 11114) for
              metals and composite storage tanks.
            </p>
            <a
              href="/search/standards?category=Embrittlement"
              class="flex items-center text-sm font-bold text-emerald-400 transition-all group-hover:gap-2"
            >
              Analyze Materials <span class="ml-1">→</span>
            </a>
          </div>

          <!-- Purity -->
          <div
            class="group rounded-3xl border border-white/5 bg-white/5 p-8 backdrop-blur-sm transition-all hover:border-purple-500/30"
          >
            <div
              class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-purple-500/20 bg-purple-500/10"
            >
              <svg
                class="h-6 w-6 text-purple-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.691.383a4 4 0 11-4.631-6.914l.117-.007a1 1 0 00.996-1.093l-.111-1.247a2 2 0 00-.734-1.267l-2.009-1.607a2 2 0 00-2.302-.192L3.5 4.857a2 2 0 00-1.023.547l-2.387.477a6 6 0 00-3.86-.517"
                ></path>
              </svg>
            </div>
            <h3 class="mb-4 text-xl font-bold">Purity & Contamination</h3>
            <p class="mb-6 text-sm leading-relaxed text-slate-400">
              ISO 14687 compliance for fuel cells. Detecting trace impurities at parts-per-billion
              level for Grade D hydrogen and above.
            </p>
            <a
              href="/search/standards?category=Purity"
              class="flex items-center text-sm font-bold text-purple-400 transition-all group-hover:gap-2"
            >
              Verify Purity <span class="ml-1">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Content / Why Section -->
    <section class="mx-auto max-w-4xl px-6 py-24">
      <div class="prose prose-invert prose-blue max-w-none">
        <h2 class="mb-8 text-3xl font-black">The Hydrogen Equipment Moat</h2>
        <p class="mb-6 font-medium leading-relaxed text-slate-400">
          Standard testing facilities are fundamentally ill-equipped for hydrogen infrastructure.
          The unique molecular properties of diatomic hydrogen require a capital-intensive "moat" of
          specialized equipment:
        </p>
        <ul class="mb-12 space-y-4">
          <li class="flex gap-4">
            <div
              class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-blue-500/40 bg-blue-500/20 text-[10px] font-black italic"
            >
              1
            </div>
            <span class="text-slate-300"
              ><strong class="text-white">Blast Buffers & Remote Ops:</strong> High-pressure pneumatic
              testing (700-1000 bar) carries a significant failure energy potential, requiring reinforced
              bunkers.</span
            >
          </li>
          <li class="flex gap-4">
            <div
              class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-blue-500/40 bg-blue-500/20 text-[10px] font-black italic"
            >
              2
            </div>
            <span class="text-slate-300"
              ><strong class="text-white">Cryogenic Gas Handling:</strong> Maintaining liquid hydrogen
              at -253°C requires specialized vacuum-jacketed lines and boil-off management.</span
            >
          </li>
          <li class="flex gap-4">
            <div
              class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-blue-500/40 bg-blue-500/20 text-[10px] font-black italic"
            >
              3
            </div>
            <span class="text-slate-300"
              ><strong class="text-white">In-Situ Embrittlement Rigs:</strong> Tensile and fatigue testing
              must occur while the material is pre-charged or actively exposed to high-pressure H2.</span
            >
          </li>
        </ul>
      </div>
    </section>

    <!-- Sticky RFQ Bar -->
    <div
      class="pointer-events-none fixed bottom-0 left-0 right-0 z-[100] bg-gradient-to-t from-black to-transparent p-6"
    >
      <div class="pointer-events-auto mx-auto max-w-4xl">
        <div
          class="flex flex-col items-center justify-between gap-4 rounded-2xl border border-white/10 bg-[#0a0a0b]/80 p-4 shadow-2xl backdrop-blur-xl sm:flex-row"
        >
          <div class="hidden sm:block">
            <div class="text-sm font-bold text-white">Need Hydrogen Testing?</div>
            <div class="text-xs text-slate-500">
              Connect with all {uniqueLabCount} labs in one request.
            </div>
          </div>
          <div class="flex w-full gap-3 sm:w-auto">
            <a
              href="#rfq"
              class="flex-1 rounded-xl bg-white px-6 py-2.5 text-center text-sm font-black text-black transition-all hover:bg-slate-200 sm:flex-none"
            >
              Submit Multiple RFQ
            </a>
            <a
              href="/search/standards?filter=hydrogen"
              class="flex-1 rounded-xl bg-white/10 px-6 py-2.5 text-center text-sm font-bold text-white transition-all hover:bg-white/20 sm:flex-none"
            >
              View All Labs
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Modals -->
    <ContactLabModal client:only="react" />

    <Footer />
  </div>
</BaseLayout>

<style is:global>
  /* BaseLayout color override to prevent flash */
  body {
    background: #020203 !important;
  }
</style>
