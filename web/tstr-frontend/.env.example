# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/haimjeaetrsaauitrhfy/settings/api

# Public keys (safe to expose to client-side)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (CRITICAL: Server-side only - DO NOT expose to client)
# This key has full database access - keep it SECRET!
# Never commit this key to git or expose it in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# PayPal Plan IDs (create these in PayPal Dashboard first)
PAYPAL_PLAN_PROFESSIONAL=P-XXXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_PREMIUM=P-XXXXXXXXXXXXXXXXXXXXX

# Site-wide visitor analytics (traffic: visitors, pages, referrers)
# RECOMMENDED FREE PROVIDER: Cloudflare Web Analytics — already in your Cloudflare
# account, free forever, cookieless (no consent banner needed), 2-minute setup.
# Enable it in the Cloudflare dashboard (see docs/active/ANALYTICS_SETUP_GUIDE.md);
# it auto-injects its script, so PUBLIC_ANALYTICS_ID is NOT required for it.
#
# PUBLIC_ANALYTICS_ID is only used if you instead choose a Plausible/Umami/Fathom
# style provider. Set it to your analytics data-domain (e.g. "tstr.directory") to
# load that provider's script. Leave blank to disable third-party traffic analytics
# entirely (internal click analytics still works, and the Apollo tracker stays
# consent-gated by the cookie banner).
PUBLIC_ANALYTICS_ID=
